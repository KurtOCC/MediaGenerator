# Mediagenerator – eksempel på miljøvariabler.
# Kopier til .env for lokal utvikling: cp .env.example .env
# INGEN VERDIER SKAL COMMITTES. I Azure settes disse som Container Apps-secrets
# med referanse til Azure Key Vault.

# ---------------------------------------------------------------------------
# Applikasjon
# ---------------------------------------------------------------------------
# Offentlig base-URL, uten skråstrek til slutt.
APP_BASE_URL=http://localhost:8080
APP_PORT=8080
# development | production. Styrer JSON-logging og HSTS/Secure-cookies.
APP_ENV=development
RUST_LOG=info,mediagenerator_web=debug
# Katalog som serveres på /assets, relativt til arbeidskatalogen.
ASSETS_DIR=assets

# ---------------------------------------------------------------------------
# Database (Azure Database for PostgreSQL Flexible Server)
# ---------------------------------------------------------------------------
DATABASE_URL=

# Nøkkel for signering av sesjonscookies. Minst 64 tegn.
# Generer med: openssl rand -base64 64
SESSION_SECRET=

# postgres (default) | memory. «memory» er kun tillatt når APP_ENV=development:
# sesjoner går tapt ved omstart og deles ikke mellom instanser.
SESSION_STORE=postgres

# ---------------------------------------------------------------------------
# Entra ID (SSO)
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Utelates ved bruk av Managed Identity i Azure.
AZURE_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
# App-rolle som kreves for tilgang. Tom verdi slår av rollesjekken.
REQUIRED_APP_ROLE=Mediagenerator.User

# ---------------------------------------------------------------------------
# Azure AI Foundry / Azure OpenAI
# ---------------------------------------------------------------------------
# Endepunkt uten skråstrek til slutt, f.eks. https://<ressurs>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# v1-API-et: api-version er valgfri og defaulter til v1. "preview" slår på
# preview-funksjoner. Verifisert mot Microsoft Learn 2026-09-16.
AZURE_OPENAI_API_VERSION=preview
IMAGE_DEPLOYMENT=
AUDIO_DEPLOYMENT=
VIDEO_DEPLOYMENT=
# Kun for lokal utvikling. Avvises når APP_ENV=production.
AZURE_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Azure Blob Storage
# ---------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=media
SAS_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Grenser og oppbevaring
# ---------------------------------------------------------------------------
MAX_PROMPT_CHARS=4000
RATE_LIMIT_PER_HOUR=20
RETENTION_DAYS=90
